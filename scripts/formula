#!/bin/bash
# Prints the Homebrew formula for one crumbkit binary release.
#
# Usage: scripts/formula <bin> <owner/repo> <version> <description> <SHA256SUMS file>
#        scripts/formula --desc <name> <description>
#
# The release must attach `<bin>-<version>-<target>.tar.gz` archives that hold
# the binary at their root, listed in SHA256SUMS. macOS takes the
# aarch64-apple-darwin and x86_64-apple-darwin archives; Linux takes the
# first <arch>-unknown-linux-* archive for each architecture. A binary with
# no macOS or Linux archive is refused. When scripts/extras/<bin>.rb exists,
# its text goes into the formula after `install`, for blocks such as
# `service`.
#
# The description is the repository's. When scripts/extras/<name>.desc
# exists, its first line replaces it. An empty description is refused,
# because Homebrew's style check rejects it. `--desc` prints the description
# Homebrew gets, for scripts/cask.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)

# Prints the description for a formula or cask named $1, from $2 or from
# scripts/extras/$1.desc. Homebrew wants no leading article, no trailing
# period and fewer than 80 characters, so a long description is cut at its
# last comma, or last space, that fits. Quotes and backslashes are escaped
# for a Ruby string.
description() {
  local name=$1 desc=$2
  if [ -f "$here/extras/$name.desc" ]; then
    desc=$(head -n 1 "$here/extras/$name.desc")
  fi
  if [ -z "$desc" ]; then
    echo "scripts/formula: $name has no description; set its repository's description or write scripts/extras/$name.desc" >&2
    return 1
  fi
  desc=${desc//\\/\\\\}
  desc=${desc//\"/\\\"}
  desc=${desc%.}
  desc=$(echo "$desc" | sed -E 's/^(A|An|The) +//')
  desc="$(echo "${desc:0:1}" | tr '[:lower:]' '[:upper:]')${desc:1}"
  while [ ${#desc} -ge 80 ]; do
    case "$desc" in
      *,*) desc=${desc%,*} ;;
      *" "*) desc=${desc% *} ;;
      *) desc=${desc:0:79} ;;
    esac
  done
  printf '%s\n' "$desc"
}

if [ "${1:-}" = --desc ]; then
  [ $# -eq 3 ] || { echo "usage: scripts/formula --desc <name> <description>" >&2; exit 2; }
  description "$2" "$3"
  exit
fi

[ $# -eq 5 ] || { echo "usage: scripts/formula <bin> <owner/repo> <version> <description> <SHA256SUMS>" >&2; exit 2; }
bin=$1 repo=$2 version=$3 desc=$4 sums=$5
base="https://github.com/$repo/releases/download/v$version"

# Prints "<sha> <asset>" for the first archive matching a target pattern.
asset() {
  awk -v re="^$bin-$version-$1\\.tar\\.gz\$" '$2 ~ re { print $1, $2; exit }' "$sums"
}

# Prints a url/sha256 pair for an asset line, indented for an on_<arch> block.
pair() {
  local sha=${1%% *} name=${1#* }
  printf '      url "%s/%s"\n      sha256 "%s"\n' "$base" "$name" "$sha"
}

mac_arm=$(asset 'aarch64-apple-darwin')
mac_intel=$(asset 'x86_64-apple-darwin')
linux_arm=$(asset 'aarch64-unknown-linux-[a-z]+')
linux_intel=$(asset 'x86_64-unknown-linux-[a-z]+')
if [ -z "$mac_arm$mac_intel$linux_arm$linux_intel" ]; then
  echo "scripts/formula: $repo v$version has no macOS or Linux archive of $bin" >&2
  exit 1
fi

# Formula class names are the binary name in CamelCase: board-top -> BoardTop.
class=$(echo "$bin" | awk -F'[-_]' '{ for (i = 1; i <= NF; i++) printf "%s", toupper(substr($i, 1, 1)) substr($i, 2) }')
desc=$(description "$bin" "$desc")

cat <<EOF
# This file is generated by scripts/generate from the latest release of
# $repo. Edit scripts/formula instead.
class $class < Formula
  desc "$desc"
  homepage "https://github.com/$repo"
  version "$version"
  license any_of: ["MIT", "Apache-2.0"]
EOF

if [ -n "$mac_arm$mac_intel" ]; then
  printf '\n  on_macos do\n'
  if [ -n "$mac_arm" ]; then
    printf '    on_arm do\n'; pair "$mac_arm"; printf '    end\n'
  fi
  if [ -n "$mac_intel" ]; then
    printf '    on_intel do\n'; pair "$mac_intel"; printf '    end\n'
  fi
  printf '  end\n'
fi

if [ -n "$linux_arm$linux_intel" ]; then
  printf '\n  on_linux do\n'
  if [ -n "$linux_arm" ]; then
    printf '    on_arm do\n'; pair "$linux_arm"; printf '    end\n'
  fi
  if [ -n "$linux_intel" ]; then
    printf '    on_intel do\n'; pair "$linux_intel"; printf '    end\n'
  fi
  printf '  end\n'
fi

cat <<EOF

  def install
    bin.install "$bin"
  end
EOF

if [ -f "$here/extras/$bin.rb" ]; then
  echo
  cat "$here/extras/$bin.rb"
fi

cat <<EOF

  def caveats
    <<~EOS
      If $bin offers agent skills, install them with:
        $bin skills install
    EOS
  end

  test do
    system bin/"$bin", "--help"
  end
end
EOF
