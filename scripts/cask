#!/bin/bash
# Prints the Homebrew cask for one crumbkit app release.
#
# Usage: scripts/cask <token> <owner/repo> <version> <description> <SHA256SUMS file>
#
# The release must list `<Name>-<version>.dmg` or `<Name>-<version>-<id>.dmg`
# in SHA256SUMS, where <id> is any run of letters, digits, dots, underscores
# and hyphens, such as bin/dmg's `board-<12 hex>.app-<12 hex>`. The dmg holds
# <Name>.app. A dmg whose name ends in
# `-unnotarised.dmg` is not notarised, so Gatekeeper would block it, and it is
# never used. A release with no other dmg is refused. crumbkit apps are built
# for Apple silicon and macOS 14 (Sonoma) or later, so every cask depends on
# both. The description comes from `scripts/formula --desc`. When
# scripts/extras/<token>.rb exists, its text goes into the cask after `app`,
# for stanzas such as `caveats`.
set -euo pipefail

[ $# -eq 5 ] || { echo "usage: scripts/cask <token> <owner/repo> <version> <description> <SHA256SUMS>" >&2; exit 2; }
token=$1 repo=$2 version=$3 desc=$4 sums=$5
here=$(cd "$(dirname "$0")" && pwd)

# The first notarised dmg of this version, as "<sha> <Name> <asset>".
dmg=$(awk -v version="$version" '
  BEGIN { v = version; gsub(/\./, "[.]", v); re = "^[A-Za-z0-9_.]+-" v "(-[A-Za-z0-9_.-]+)?[.]dmg$" }
  $2 ~ re && $2 !~ /-unnotarised\.dmg$/ {
    name = $2; sub("-" v ".*$", "", name)
    print $1, name, $2; exit
  }' "$sums")
if [ -z "$dmg" ]; then
  echo "scripts/cask: $repo v$version has no notarised dmg" >&2
  exit 1
fi
read -r sha name asset <<<"$dmg"
desc=$("$here/formula" --desc "$token" "$desc")
# The URL names the version through the cask's #{version}, as Homebrew prefers.
interpolated='#{version}'
asset_url=${asset//"$version"/$interpolated}

cat <<CASK
# This file is generated by scripts/generate from the latest release of
# $repo. Edit scripts/cask instead.
cask "$token" do
  version "$version"
  sha256 "$sha"

  url "https://github.com/$repo/releases/download/v#{version}/$asset_url"
  name "$name"
  desc "$desc"
  homepage "https://github.com/$repo"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on arch: :arm64
  depends_on macos: :sonoma

  app "$name.app"
CASK

if [ -f "$here/extras/$token.rb" ]; then
  echo
  cat "$here/extras/$token.rb"
fi

echo end
